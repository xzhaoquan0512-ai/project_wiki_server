node_modules/
data/
dist/
# Knowledge and backup directories must stay outside service version control.
/raw/
/wiki/
/backups/
# Keep only the empty default and generic example project registrations.
/config/*.json
!/config/projects.json
!/config/projects.example.json
# Runtime state a vault creates in place: locks, source registry, history and extraction cache.
.wiki-server/
*.local.json
*.local.toml
# Belt and braces for machine-local registries: /config/*.json only covers the config
# directory, while these patterns also catch files copied or created elsewhere.
*local*.json
*local*.toml
.env
.env.*
!.env.example
