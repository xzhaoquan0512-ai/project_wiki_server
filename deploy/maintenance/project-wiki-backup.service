[Unit]
Description=Project Wiki backup with checksum and isolated restore verification
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/project-wiki-server
Environment=PROJECT_WIKI_MAX_SOURCE_MIB=32
ExecStart=/usr/bin/flock -w 7200 /home/ubuntu/project-wiki-maintenance/job.lock /usr/bin/node /home/ubuntu/project-wiki-server/bin/maintain-vault.mjs backup /home/ubuntu/project-wiki-server/data/vault /home/ubuntu/project-wiki-backups
UMask=0077
Nice=10
MemoryMax=1200M
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
